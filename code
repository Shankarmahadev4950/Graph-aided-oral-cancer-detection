class GraphConstructor:
    """
    Class for constructing graphs from histopathology image patches
    """
    
    def __init__(self, patch_size=256, connectivity='grid', k_neighbors=8, 
                 distance_threshold=None, add_self_loops=True):
        """
        Args:
            patch_size (int): Size of patches used for tiling
            connectivity (str): Type of connectivity ('grid', 'knn', 'radius', 'hybrid')
            k_neighbors (int): Number of nearest neighbors for KNN connectivity
            distance_threshold (float): Distance threshold for radius connectivity
            add_self_loops (bool): Whether to add self loops to the graph
        """
        self.patch_size = patch_size
        self.connectivity = connectivity
        self.k_neighbors = k_neighbors
        self.distance_threshold = distance_threshold
        self.add_self_loops = add_self_loops
        
    def construct_spatial_graph(self, coordinates, image_shape=None):
        """
        Construct spatial adjacency graph based on patch coordinates
        
        Args:
            coordinates (list): List of (row, col) coordinates for each patch
            image_shape (tuple): Original image shape (height, width)
            
        Returns:
            torch.Tensor: Edge index tensor of shape (2, num_edges)
        """
        coordinates = np.array(coordinates)
        num_patches = len(coordinates)
        
        if self.connectivity == 'grid':
            return self._construct_grid_graph(coordinates)
        elif self.connectivity == 'knn':
            return self._construct_knn_graph(coordinates)
        elif self.connectivity == 'radius':
            return self._construct_radius_graph(coordinates)
        elif self.connectivity == 'hybrid':
            return self._construct_hybrid_graph(coordinates)
        else:
            raise ValueError(f"Unknown connectivity type: {self.connectivity}")
    
    def _construct_grid_graph(self, coordinates):
        """
        Construct graph based on spatial grid adjacency
        """
        edge_list = []
        coord_to_idx = {tuple(coord): idx for idx, coord in enumerate(coordinates)}
        
        for idx, (row, col) in enumerate(coordinates):
            # Check 8-connected neighborhood (including diagonals)
            neighbors = [
                (row - self.patch_size, col),                    # Up
                (row + self.patch_size, col),                    # Down  
                (row, col - self.patch_size),                    # Left
                (row, col + self.patch_size),                    # Right
                (row - self.patch_size, col - self.patch_size),  # Up-Left
                (row - self.patch_size, col + self.patch_size),  # Up-Right
                (row + self.patch_size, col - self.patch_size),  # Down-Left
                (row + self.patch_size, col + self.patch_size),  # Down-Right
            ]
            
            for neighbor_coord in neighbors:
                if tuple(neighbor_coord) in coord_to_idx:
                    neighbor_idx = coord_to_idx[tuple(neighbor_coord)]
                    edge_list.append([idx, neighbor_idx])
        
        if len(edge_list) == 0:
            # No connections found, create empty edge index
            edge_index = torch.zeros((2, 0), dtype=torch.long)
        else:
            edge_index = torch.tensor(edge_list, dtype=torch.long).t()
            edge_index = to_undirected(edge_index)
        
        if self.add_self_loops:
            # Add self loops
            num_nodes = len(coordinates)
            self_loops = torch.arange(num_nodes).unsqueeze(0).repeat(2, 1)
            edge_index = torch.cat([edge_index, self_loops], dim=1)
        
        return edge_index
    
    def _construct_knn_graph(self, coordinates):
        """
        Construct K-nearest neighbors graph
        """
        if len(coordinates) <= self.k_neighbors:
            # If we have fewer patches than k_neighbors, connect all to all
            k = len(coordinates) - 1
        else:
            k = self.k_neighbors
        
        if k <= 0:
            # Single patch case
            edge_index = torch.zeros((2, 0), dtype=torch.long)
        else:
            nbrs = NearestNeighbors(n_neighbors=k+1, algorithm='ball_tree').fit(coordinates)
            distances, indices = nbrs.kneighbors(coordinates)
            
            edge_list = []
            for i, neighbors in enumerate(indices):
                for neighbor in neighbors[1:]:  # Skip self (first element)
                    edge_list.append([i, neighbor])
            
            if len(edge_list) == 0:
                edge_index = torch.zeros((2, 0), dtype=torch.long)
            else:
                edge_index = torch.tensor(edge_list, dtype=torch.long).t()
                edge_index = to_undirected(edge_index)
        
        if self.add_self_loops:
            num_nodes = len(coordinates)
            self_loops = torch.arange(num_nodes).unsqueeze(0).repeat(2, 1)
            edge_index = torch.cat([edge_index, self_loops], dim=1)
        
        return edge_index
    
    def _construct_radius_graph(self, coordinates):
        """
        Construct radius-based graph
        """
        if self.distance_threshold is None:
            # Default to 1.5 times patch size
            self.distance_threshold = 1.5 * self.patch_size
        
        distances = np.linalg.norm(coordinates[:, np.newaxis] - coordinates[np.newaxis, :], axis=2)
        
        edge_list = []
        for i in range(len(coordinates)):
            for j in range(i+1, len(coordinates)):
                if distances[i, j] <= self.distance_threshold:
                    edge_list.append([i, j])
                    edge_list.append([j, i])  # Add reverse edge
        
        if len(edge_list) == 0:
            edge_index = torch.zeros((2, 0), dtype=torch.long)
        else:
            edge_index = torch.tensor(edge_list, dtype=torch.long).t()
        
        if self.add_self_loops:
            num_nodes = len(coordinates)
            self_loops = torch.arange(num_nodes).unsqueeze(0).repeat(2, 1)
            edge_index = torch.cat([edge_index, self_loops], dim=1)
        
        return edge_index
    
    def _construct_hybrid_graph(self, coordinates):
        """
        Construct hybrid graph combining spatial and feature-based connectivity
        """
        # Start with grid-based connectivity
        spatial_edges = self._construct_grid_graph(coordinates)
        
        # Add KNN connectivity for additional connections
        knn_edges = self._construct_knn_graph(coordinates)
        
        # Combine edges and remove duplicates
        all_edges = torch.cat([spatial_edges, knn_edges], dim=1)
        all_edges = torch.unique(all_edges, dim=1)
        
        return all_edges


class OSCCGraphDataset:
    """
    Dataset class for creating graph representations of OSCC histopathology images
    """
    
    def __init__(self, feature_data, graph_constructor, image_level_labels=None, 
                 normalize_features=True):
        """
        Args:
            feature_data (dict): Dictionary with 'features', 'labels', 'metadata'
            graph_constructor (GraphConstructor): Graph construction object
            image_level_labels (dict): Mapping from image_id to image-level label
            normalize_features (bool): Whether to normalize node features
        """
        self.feature_data = feature_data
        self.graph_constructor = graph_constructor
        self.image_level_labels = image_level_labels
        self.normalize_features = normalize_features
        
        # Group patches by image
        self.image_groups = self._group_patches_by_image()
        
        # Normalize features if requested
        if self.normalize_features:
            self.scaler = StandardScaler()
            self.feature_data['features'] = self.scaler.fit_transform(
                self.feature_data['features']
            )
        
        # Create graph data objects
        self.graph_data_list = self._create_graph_data_objects()
    
    def _group_patches_by_image(self):
        """
        Group patches by their source image
        
        Returns:
            dict: Dictionary mapping image_id to patch indices
        """
        image_groups = {}
        
        for idx, metadata in enumerate(self.feature_data['metadata']):
            image_id = metadata['image_id']
            if image_id not in image_groups:
                image_groups[image_id] = []
            image_groups[image_id].append(idx)
        
        print(f"Grouped {len(self.feature_data['features'])} patches into {len(image_groups)} images")
        
        return image_groups
    
    def _create_graph_data_objects(self):
        """
        Create PyTorch Geometric Data objects for each image
        
        Returns:
            list: List of torch_geometric.data.Data objects
        """
        graph_data_list = []
        
        print("Creating graph data objects...")
        
        for image_id, patch_indices in tqdm(self.image_groups.items()):
            # Get features and coordinates for this image
            features = self.feature_data['features'][patch_indices]
            coordinates = [self.feature_data['metadata'][idx]['coordinates'] 
                          for idx in patch_indices]
            
            # Construct spatial graph
            edge_index = self.graph_constructor.construct_spatial_graph(coordinates)
            
            # Get image-level label
            if self.image_level_labels is not None:
                image_label = self.image_level_labels.get(image_id, 0)
            else:
                # Use majority vote from patch labels
                patch_labels = [self.feature_data['labels'][idx] for idx in patch_indices]
                image_label = max(set(patch_labels), key=patch_labels.count)
            
            # Create PyTorch Geometric Data object
            data = Data(
                x=torch.tensor(features, dtype=torch.float),
                edge_index=edge_index,
                y=torch.tensor(image_label, dtype=torch.long),
                num_nodes=len(features),
                image_id=image_id,
                coordinates=coordinates
            )
            
            graph_data_list.append(data)
        
        print(f"Created {len(graph_data_list)} graph data objects")
        
        return graph_data_list
    
    def __len__(self):
        return len(self.graph_data_list)
    
    def __getitem__(self, idx):
        return self.graph_data_list[idx]
    
    def get_data_statistics(self):
        """
        Get statistics about the graph dataset
        
        Returns:
            dict: Dataset statistics
        """
        if not self.graph_data_list:
            return {}
        
        num_nodes = [data.num_nodes for data in self.graph_data_list]
        num_edges = [data.edge_index.size(1) for data in self.graph_data_list]
        labels = [data.y.item() for data in self.graph_data_list]
        
        stats = {
            'num_graphs': len(self.graph_data_list),
            'num_features': self.graph_data_list[0].x.size(1),
            'num_classes': len(set(labels)),
            'avg_nodes_per_graph': np.mean(num_nodes),
            'std_nodes_per_graph': np.std(num_nodes),
            'avg_edges_per_graph': np.mean(num_edges),
            'std_edges_per_graph': np.std(num_edges),
            'class_distribution': {i: labels.count(i) for i in set(labels)}
        }
        
        return stats


def create_graph_dataloaders(graph_dataset, train_indices, val_indices, test_indices,
                           batch_size=32, num_workers=4):
    """
    Create DataLoaders for graph data with proper batching
    
    Args:
        graph_dataset (OSCCGraphDataset): Graph dataset
        train_indices (list): Training indices
        val_indices (list): Validation indices  
        test_indices (list): Test indices
        batch_size (int): Batch size
        num_workers (int): Number of workers for data loading
        
    Returns:
        tuple: (train_loader, val_loader, test_loader)
    """
    from torch.utils.data import Subset
    
    # Create subsets
    train_dataset = Subset(graph_dataset, train_indices)
    val_dataset = Subset(graph_dataset, val_indices)
    test_dataset = Subset(graph_dataset, test_indices)
    
    # Create DataLoaders with PyTorch Geometric's DataLoader
    train_loader = DataLoader(train_dataset, batch_size=batch_size, 
                             shuffle=True, num_workers=num_workers)
    val_loader = DataLoader(val_dataset, batch_size=batch_size, 
                           shuffle=False, num_workers=num_workers)
    test_loader = DataLoader(test_dataset, batch_size=batch_size, 
                            shuffle=False, num_workers=num_workers)
    
    return train_loader, val_loader, test_loader


def visualize_graph_structure(data, save_path=None, max_nodes=100):
    """
    Visualize the graph structure for a single image
    
    Args:
        data (torch_geometric.data.Data): Graph data object
        save_path (str): Path to save visualization
        max_nodes (int): Maximum number of nodes to visualize
    """
    if data.num_nodes > max_nodes:
        print(f"Too many nodes ({data.num_nodes}), sampling {max_nodes} for visualization")
        # Sample nodes for visualization
        selected_nodes = np.random.choice(data.num_nodes, max_nodes, replace=False)
        # Create subgraph (this is simplified - proper subgraph extraction is more complex)
        node_mask = torch.zeros(data.num_nodes, dtype=torch.bool)
        node_mask[selected_nodes] = True
        edge_mask = node_mask[data.edge_index[0]] & node_mask[data.edge_index[1]]
        edge_index = data.edge_index[:, edge_mask]
        # Remap node indices
        node_mapping = {old_idx.item(): new_idx for new_idx, old_idx in enumerate(selected_nodes)}
        edge_index = torch.tensor([[node_mapping[edge_index[0, i].item()], 
                                   node_mapping[edge_index[1, i].item()]] 
                                  for i in range(edge_index.size(1))]).t()
        coordinates = [data.coordinates[i] for i in selected_nodes]
    else:
        edge_index = data.edge_index
        coordinates = data.coordinates
    
    # Create NetworkX graph
    G = nx.Graph()
    G.add_edges_from(edge_index.t().numpy())
    
    # Use spatial coordinates for node positions
    pos = {i: (coord[1], -coord[0]) for i, coord in enumerate(coordinates)}  # (col, -row)
    
    plt.figure(figsize=(12, 8))
    
    # Draw graph
    nx.draw(G, pos, node_size=50, node_color='lightblue', 
            edge_color='gray', alpha=0.7, width=0.5)
    
    plt.title(f"Graph Structure (Image ID: {data.image_id}, Label: {data.y.item()})\n"
              f"Nodes: {len(coordinates)}, Edges: {edge_index.size(1)}")
    plt.axis('equal')
    
    if save_path:
        plt.savefig(save_path, dpi=300, bbox_inches='tight')
        print(f"Graph visualization saved to {save_path}")
    
    plt.show()



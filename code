"""
Phase 1: Patch-Level Feature Extraction (CNN Backbone)
======================================================

This module implements CNN backbone for extracting patch-level features using ResNet-50
with both frozen feature extraction and fine-tuning strategies.
"""

import torch
import torch.nn as nn
import torch.nn.functional as F
from torchvision import models, transforms
from torch.utils.data import DataLoader
import numpy as np
from tqdm import tqdm
import os
from pathlib import Path
import pickle


class ResNetFeatureExtractor(nn.Module):
    """
    ResNet-50 based feature extractor for histopathology patches
    """
    
    def __init__(self, pretrained=True, frozen=True, feature_dim=2048):
        """
        Args:
            pretrained (bool): Use ImageNet pretrained weights
            frozen (bool): Freeze backbone weights for feature extraction
            feature_dim (int): Dimension of output features
        """
        super(ResNetFeatureExtractor, self).__init__()
        
        # Load pretrained ResNet-50
        self.backbone = models.resnet50(pretrained=pretrained)
        
        # Remove final classification layer
        self.backbone = nn.Sequential(*list(self.backbone.children())[:-1])
        
        self.frozen = frozen
        self.feature_dim = feature_dim
        
        if frozen:
            # Freeze all parameters for feature extraction
            for param in self.backbone.parameters():
                param.requires_grad = False
            self.backbone.eval()
            print("ResNet-50 backbone frozen for feature extraction")
        else:
            print("ResNet-50 backbone unfrozen for fine-tuning")
        
        # Add global average pooling to ensure consistent output size
        self.global_pool = nn.AdaptiveAvgPool2d((1, 1))
        
    def forward(self, x):
        """
        Forward pass through backbone
        
        Args:
            x (torch.Tensor): Input images (B, C, H, W)
            
        Returns:
            torch.Tensor: Feature vectors (B, feature_dim)
        """
        if self.frozen:
            with torch.no_grad():
                features = self.backbone(x)
        else:
            features = self.backbone(x)
        
        # Global average pooling and flatten
        features = self.global_pool(features)
        features = features.view(features.size(0), -1)
        
        return features


class ResNetFineTuner(nn.Module):
    """
    ResNet-50 with classification head for fine-tuning on OSCC patches
    """
    
    def __init__(self, pretrained=True, num_classes=2, dropout_rate=0.5):
        """
        Args:
            pretrained (bool): Use ImageNet pretrained weights
            num_classes (int): Number of output classes
            dropout_rate (float): Dropout rate for classification head
        """
        super(ResNetFineTuner, self).__init__()
        
        # Load pretrained ResNet-50
        self.backbone = models.resnet50(pretrained=pretrained)
        
        # Get feature dimension from last layer
        feature_dim = self.backbone.fc.in_features
        
        # Replace final layer with custom classification head
        self.backbone.fc = nn.Sequential(
            nn.Dropout(dropout_rate),
            nn.Linear(feature_dim, 512),
            nn.ReLU(inplace=True),
            nn.Dropout(dropout_rate),
            nn.Linear(512, num_classes)
        )
        
        print(f"ResNet-50 fine-tuner initialized with {num_classes} classes")
    
    def forward(self, x):
        """
        Forward pass through full network
        
        Args:
            x (torch.Tensor): Input images (B, C, H, W)
            
        Returns:
            torch.Tensor: Class logits (B, num_classes)
        """
        return self.backbone(x)
    
    def extract_features(self, x):
        """
        Extract features from penultimate layer
        
        Args:
            x (torch.Tensor): Input images (B, C, H, W)
            
        Returns:
            torch.Tensor: Feature vectors (B, feature_dim)
        """
        # Forward through all layers except final classification
        features = nn.Sequential(*list(self.backbone.children())[:-1])(x)
        features = F.adaptive_avg_pool2d(features, (1, 1))
        features = features.view(features.size(0), -1)
        return features


def get_patch_transforms(image_size=224, is_training=True):
    """
    Get appropriate transforms for patch preprocessing
    
    Args:
        image_size (int): Target image size
        is_training (bool): Whether for training (includes augmentation)
        
    Returns:
        torchvision.transforms.Compose: Transform pipeline
    """
    if is_training:
        transform = transforms.Compose([
            transforms.ToPILImage(),
            transforms.Resize((image_size, image_size)),
            transforms.RandomHorizontalFlip(p=0.5),
            transforms.RandomVerticalFlip(p=0.5),
            transforms.RandomRotation(degrees=90),
            transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2, hue=0.1),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                               std=[0.229, 0.224, 0.225])
        ])
    else:
        transform = transforms.Compose([
            transforms.ToPILImage(),
            transforms.Resize((image_size, image_size)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], 
                               std=[0.229, 0.224, 0.225])
        ])
    
    return transform


def extract_features_from_patches(model, dataloader, device, save_path=None):
    """
    Extract features from patches using trained/pretrained model
    
    Args:
        model (nn.Module): Feature extraction model
        dataloader (DataLoader): DataLoader with patches
        device (torch.device): Device to run inference on
        save_path (str): Path to save extracted features
        
    Returns:
        dict: Dictionary containing features, labels, and metadata
    """
    model.eval()
    model.to(device)
    
    all_features = []
    all_labels = []
    all_metadata = []
    
    print("Extracting features from patches...")
    
    with torch.no_grad():
        for batch_idx, (patches, labels, metadata) in enumerate(tqdm(dataloader)):
            patches = patches.to(device)
            
            # Extract features
            if hasattr(model, 'extract_features'):
                features = model.extract_features(patches)
            else:
                features = model(patches)
            
            # Move to CPU and convert to numpy
            features = features.cpu().numpy()
            labels = labels.numpy()
            
            all_features.append(features)
            all_labels.extend(labels)
            all_metadata.extend(metadata)
    
    # Concatenate all features
    all_features = np.concatenate(all_features, axis=0)
    all_labels = np.array(all_labels)
    
    feature_data = {
        'features': all_features,
        'labels': all_labels,
        'metadata': all_metadata
    }
    
    print(f"Extracted {all_features.shape[0]} feature vectors of dimension {all_features.shape[1]}")
    
    # Save features if path provided
    if save_path:
        os.makedirs(os.path.dirname(save_path), exist_ok=True)
        with open(save_path, 'wb') as f:
            pickle.dump(feature_data, f)
        print(f"Features saved to {save_path}")
    
    return feature_data


def train_resnet_classifier(model, train_loader, val_loader, device, num_epochs=50, 
                           learning_rate=1e-4, weight_decay=1e-4, save_path=None):
    """
    Train ResNet classifier on OSCC patches
    
    Args:
        model (nn.Module): ResNet model to train
        train_loader (DataLoader): Training data loader
        val_loader (DataLoader): Validation data loader
        device (torch.device): Device for training
        num_epochs (int): Number of training epochs
        learning_rate (float): Initial learning rate
        weight_decay (float): Weight decay for regularization
        save_path (str): Path to save best model
        
    Returns:
        dict: Training history
    """
    model.to(device)
    
    # Loss function and optimizer
    criterion = nn.CrossEntropyLoss()
    optimizer = torch.optim.AdamW(model.parameters(), lr=learning_rate, weight_decay=weight_decay)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=num_epochs)
    
    # Training history
    history = {
        'train_loss': [], 'train_acc': [],
        'val_loss': [], 'val_acc': []
    }
    
    best_val_acc = 0.0
    best_model_state = None
    
    print(f"Training ResNet classifier for {num_epochs} epochs...")
    
    for epoch in range(num_epochs):
        # Training phase
        model.train()
        train_loss = 0.0
        train_correct = 0
        train_total = 0
        
        for patches, labels, _ in tqdm(train_loader, desc=f"Epoch {epoch+1}/{num_epochs} [Train]"):
            patches, labels = patches.to(device), labels.to(device)
            
            optimizer.zero_grad()
            outputs = model(patches)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()
            
            train_loss += loss.item()
            _, predicted = outputs.max(1)
            train_total += labels.size(0)
            train_correct += predicted.eq(labels).sum().item()
        
        train_loss = train_loss / len(train_loader)
        train_acc = 100. * train_correct / train_total
        
        # Validation phase
        model.eval()
        val_loss = 0.0
        val_correct = 0
        val_total = 0
        
        with torch.no_grad():
            for patches, labels, _ in tqdm(val_loader, desc=f"Epoch {epoch+1}/{num_epochs} [Val]"):
                patches, labels = patches.to(device), labels.to(device)
                
                outputs = model(patches)
                loss = criterion(outputs, labels)
                
                val_loss += loss.item()
                _, predicted = outputs.max(1)
                val_total += labels.size(0)
                val_correct += predicted.eq(labels).sum().item()
        
        val_loss = val_loss / len(val_loader)
        val_acc = 100. * val_correct / val_total
        
        # Update learning rate
        scheduler.step()
        
        # Save history
        history['train_loss'].append(train_loss)
        history['train_acc'].append(train_acc)
        history['val_loss'].append(val_loss)
        history['val_acc'].append(val_acc)
        
        # Save best model
        if val_acc > best_val_acc:
            best_val_acc = val_acc
            best_model_state = model.state_dict().copy()
        
        print(f"Epoch {epoch+1}: Train Loss: {train_loss:.4f}, Train Acc: {train_acc:.2f}%, "
              f"Val Loss: {val_loss:.4f}, Val Acc: {val_acc:.2f}%")
    
    # Load best model
    if best_model_state is not None:
        model.load_state_dict(best_model_state)
        print(f"Best validation accuracy: {best_val_acc:.2f}%")
    
    # Save model if path provided
    if save_path:
        os.makedirs(os.path.dirname(save_path), exist_ok=True)
        torch.save({
            'model_state_dict': model.state_dict(),
            'history': history,
            'best_val_acc': best_val_acc
        }, save_path)
        print(f"Best model saved to {save_path}")
    
    return history


class PatchDataset(torch.utils.data.Dataset):
    """
    Simple dataset wrapper for patch data with transforms
    """
    
    def __init__(self, patches, labels, metadata, transform=None):
        self.patches = patches
        self.labels = labels
        self.metadata = metadata
        self.transform = transform
    
    def __len__(self):
        return len(self.patches)
    
    def __getitem__(self, idx):
        patch = self.patches[idx]
        label = self.labels[idx]
        meta = self.metadata[idx] if self.metadata else {}
        
        if self.transform:
            patch = self.transform(patch)
        
        return patch, label, meta



class GATClassifier(nn.Module):
    """
    Graph Attention Network for OSCC classification
    """
    
    def __init__(self, input_dim, hidden_dim=64, num_heads=4, num_layers=3, 
                 num_classes=2, dropout=0.3, use_batch_norm=True):
        """
        Args:
            input_dim (int): Input feature dimension
            hidden_dim (int): Hidden layer dimension
            num_heads (int): Number of attention heads
            num_layers (int): Number of GAT layers
            num_classes (int): Number of output classes
            dropout (float): Dropout rate
            use_batch_norm (bool): Whether to use batch normalization
        """
        super(GATClassifier, self).__init__()
        
        self.input_dim = input_dim
        self.hidden_dim = hidden_dim
        self.num_heads = num_heads
        self.num_layers = num_layers
        self.num_classes = num_classes
        self.dropout = dropout
        self.use_batch_norm = use_batch_norm
        
        # GAT layers
        self.gat_layers = nn.ModuleList()
        self.batch_norms = nn.ModuleList() if use_batch_norm else None
        
        # First layer
        self.gat_layers.append(
            GATConv(input_dim, hidden_dim, heads=num_heads, dropout=dropout, concat=True)
        )
        if use_batch_norm:
            self.batch_norms.append(BatchNorm(hidden_dim * num_heads))
        
        # Hidden layers
        for _ in range(num_layers - 2):
            self.gat_layers.append(
                GATConv(hidden_dim * num_heads, hidden_dim, heads=num_heads, 
                       dropout=dropout, concat=True)
            )
            if use_batch_norm:
                self.batch_norms.append(BatchNorm(hidden_dim * num_heads))
        
        # Final layer (average heads)
        self.gat_layers.append(
            GATConv(hidden_dim * num_heads, hidden_dim, heads=num_heads, 
                   dropout=dropout, concat=False)
        )
        if use_batch_norm:
            self.batch_norms.append(BatchNorm(hidden_dim))
        
        # Global pooling and classification head
        self.classifier = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim // 2),
            nn.ReLU(inplace=True),
            nn.Dropout(dropout),
            nn.Linear(hidden_dim // 2, num_classes)
        )
        
        print(f"GATClassifier initialized: {num_layers} layers, {num_heads} heads, "
              f"{hidden_dim} hidden dim")
    
    def forward(self, x, edge_index, batch):
        """
        Forward pass
        
        Args:
            x (torch.Tensor): Node features (N, input_dim)
            edge_index (torch.Tensor): Edge indices (2, E)
            batch (torch.Tensor): Batch vector (N,)
            
        Returns:
            torch.Tensor: Class logits (batch_size, num_classes)
            torch.Tensor: Attention weights for interpretability
        """
        attention_weights = []
        
        # Apply GAT layers
        for i, gat_layer in enumerate(self.gat_layers):
            x, att_weights = gat_layer(x, edge_index, return_attention_weights=True)
            attention_weights.append(att_weights)
            
            # Apply batch normalization
            if self.use_batch_norm and i < len(self.batch_norms):
                x = self.batch_norms[i](x)
            
            # Apply activation (except for last layer)
            if i < len(self.gat_layers) - 1:
                x = F.relu(x)
                x = F.dropout(x, p=self.dropout, training=self.training)
        
        # Global pooling
        x = global_mean_pool(x, batch)
        
        # Classification
        logits = self.classifier(x)
        
        return logits, attention_weights


class GCNClassifier(nn.Module):
    """
    Graph Convolutional Network baseline for comparison
    """
    
    def __init__(self, input_dim, hidden_dim=64, num_layers=3, num_classes=2, 
                 dropout=0.3, use_batch_norm=True):
        """
        Args:

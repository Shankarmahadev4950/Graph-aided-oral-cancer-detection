class AttentionVisualizer:
    """
    Visualize attention weights for GAT model interpretability
    """
    
    def __init__(self, model, device):
        self.model = model
        self.device = device
        self.model.eval()
        self.model.to(device)
    
    def extract_attention_weights(self, data):
        data = data.to(self.device)
        with torch.no_grad():
            logits, attention_weights = self.model(data.x, data.edge_index, 
                                                  torch.zeros(data.num_nodes, dtype=torch.long).to(self.device))
        prediction = torch.argmax(logits, dim=1).item()
        return attention_weights, prediction
    
    def create_attention_heatmap(self, data, patch_size=256, image_shape=None, 
                               layer_idx=-1, save_path=None):
        attention_weights, prediction = self.extract_attention_weights(data)
        edge_index, att_weights = attention_weights[layer_idx]
        node_attention = torch.zeros(data.num_nodes, device=self.device)
        for i, (_, dst) in enumerate(edge_index.t()):
            node_attention[dst] += att_weights[i].mean()
        node_attention = node_attention.cpu().numpy()
        node_attention = node_attention / node_attention.max() if node_attention.max() > 0 else node_attention
        if image_shape is None:
            coords = np.array(data.coordinates)
            image_shape = (coords[:, 0].max() + patch_size, coords[:, 1].max() + patch_size)
        heatmap = np.zeros(image_shape)
        for i, (row, col) in enumerate(data.coordinates):
            heatmap[row:row+patch_size, col:col+patch_size] = node_attention[i]
        plt.figure(figsize=(12, 4))
        plt.subplot(1, 2, 1)
        plt.imshow(heatmap, cmap='Reds')
        plt.title(f'Attention Heatmap (Pred: {"OSCC" if prediction==1 else "Normal"})')
        plt.axis('off')
        plt.subplot(1, 2, 2)
        plt.hist(node_attention, bins=20, color='red', alpha=0.7)
        plt.title('Attention Distribution')
        plt.tight_layout()
        if save_path:
            plt.savefig(save_path, dpi=300, bbox_inches='tight')
        plt.show()
        return heatmap



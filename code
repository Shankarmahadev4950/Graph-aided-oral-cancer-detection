def set_random_seeds(seed=42):
    """
    Set random seeds for reproducibility across all libraries
    
    Args:
        seed (int): Random seed value
    """
    # Set Python random seed
    random.seed(seed)
    
    # Set NumPy random seed
    np.random.seed(seed)
    
    # Set PyTorch random seeds
    torch.manual_seed(seed)
    torch.cuda.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    
    # Set deterministic behavior
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False
    
    # Set environment variable for hash seed
    os.environ['PYTHONHASHSEED'] = str(seed)
    
    print(f"Random seeds set to {seed} for reproducibility")


def macenko_stain_normalization(image, target_stain_matrix=None, target_concentrations=None):
    """
    Implement Macenko stain normalization for H&E stained histopathology images
    
    Args:
        image (np.array): Input RGB image (H, W, 3)
        target_stain_matrix (np.array): Target stain matrix (2, 3) [H, E stains]
        target_concentrations (np.array): Target stain concentrations (2,)
    
    Returns:
        np.array: Normalized image
    """
    # Default H&E stain matrix and concentrations from literature
    if target_stain_matrix is None:
        target_stain_matrix = np.array([[0.65, 0.70, 0.29],  # Hematoxylin
                                       [0.07, 0.99, 0.11]])  # Eosin
    
    if target_concentrations is None:
        target_concentrations = np.array([1.9705, 1.0308])
    
    # Convert RGB to optical density (OD)
    image_norm = image.astype(np.float64) / 255.0
    image_norm = np.maximum(image_norm, 1e-6)  # Avoid log(0)
    od_image = -np.log10(image_norm)
    
    # Remove background pixels (low OD)
    od_threshold = 0.15
    od_mask = np.sum(od_image, axis=2) > od_threshold
    od_pixels = od_image[od_mask]
    
    if len(od_pixels) == 0:
        return image  # Return original if no foreground pixels
    
    # Singular Value Decomposition
    try:
        U, s, Vt = np.linalg.svd(od_pixels.T, full_matrices=False)
        
        # Create plane from first 2 singular vectors
        if len(s) >= 2:
            plane = U[:, :2]
            
            # Project OD pixels onto the plane
            projected = np.dot(od_pixels, plane)
            
            # Normalize to unit length
            projected_norm = projected / np.linalg.norm(projected, axis=1, keepdims=True)
            
            # Find angles with respect to first direction
            angles = np.arctan2(projected_norm[:, 1], projected_norm[:, 0])
            
            # Find robust extremes (1st and 99th percentiles)
            min_angle = np.percentile(angles, 1)
            max_angle = np.percentile(angles, 99)
            
            # Convert back to OD space
            extreme_angles = np.array([min_angle, max_angle])
            stain_vectors = np.array([
                [np.cos(extreme_angles[0]), np.sin(extreme_angles[0])],
                [np.cos(extreme_angles[1]), np.sin(extreme_angles[1])]
            ])
            
            # Convert to original space
            stain_matrix = np.dot(stain_vectors, plane.T)
            
            # Ensure stain directions are correct (H should be more blue, E more pink)
            if stain_matrix[0, 2] > stain_matrix[1, 2]:
                stain_matrix = stain_matrix[[1, 0], :]
            
            # Calculate concentrations
            concentrations = np.linalg.lstsq(stain_matrix.T, od_pixels.T, rcond=None)[0]
            
            # Find robust maxima (99th percentile)
            max_concentrations = np.percentile(concentrations, 99, axis=1)
            
            # Normalize concentrations
            concentrations_normalized = concentrations * (target_concentrations[:, np.newaxis] / max_concentrations[:, np.newaxis])
            
            # Reconstruct normalized image
            od_normalized = np.dot(target_stain_matrix.T, concentrations_normalized)
            
            # Convert back to RGB
            image_normalized = 10**(-od_normalized.T)
            image_normalized = np.clip(image_normalized * 255, 0, 255).astype(np.uint8)
            
            # Reconstruct full image
            result = np.copy(image)
            result[od_mask] = image_normalized
            
            return result
            
    except np.linalg.LinAlgError:
        print("SVD failed, returning original image")
        return image
    
    return image


def tile_image(image, patch_size=256, overlap=0, min_foreground_ratio=0.1):
    """
    Tile a large histopathology image into smaller patches
    
    Args:
        image (np.array): Input image (H, W, C)
        patch_size (int): Size of square patches
        overlap (float): Overlap ratio between patches (0-1)
        min_foreground_ratio (float): Minimum foreground ratio to keep patch
    
    Returns:
        list: List of patches with their coordinates
        list: List of coordinates (row, col) for each patch
    """
    h, w = image.shape[:2]
    stride = int(patch_size * (1 - overlap))
    
    patches = []
    coordinates = []
    
    for row in range(0, h - patch_size + 1, stride):
        for col in range(0, w - patch_size + 1, stride):
            patch = image[row:row + patch_size, col:col + patch_size]
            
            # Calculate foreground ratio (non-white pixels)
            if len(patch.shape) == 3:
                gray_patch = cv2.cvtColor(patch, cv2.COLOR_RGB2GRAY)
            else:
                gray_patch = patch
            
            foreground_ratio = np.sum(gray_patch < 240) / (patch_size * patch_size)
            
            if foreground_ratio >= min_foreground_ratio:
                patches.append(patch)
                coordinates.append((row, col))
    
    return patches, coordinates


class OSCCDataset(Dataset):
    """
    Dataset class for OSCC histopathology images with preprocessing
    """
    
    def __init__(self, image_paths, labels, patch_size=256, apply_normalization=True, 
                 transform=None, min_foreground_ratio=0.1):
        """
        Args:
            image_paths (list): List of paths to histopathology images
            labels (list): List of labels (0: Normal, 1: OSCC)
            patch_size (int): Size of patches to extract
            apply_normalization (bool): Whether to apply Macenko normalization
            transform: Additional transforms to apply
            min_foreground_ratio (float): Minimum foreground content
        """
        self.image_paths = image_paths
        self.labels = labels
        self.patch_size = patch_size
        self.apply_normalization = apply_normalization
        self.transform = transform
        self.min_foreground_ratio = min_foreground_ratio
        
        # Process all images and extract patches
        self.patches = []
        self.patch_labels = []
        self.patch_metadata = []
        
        self._extract_all_patches()
    
    def _extract_all_patches(self):
        """Extract patches from all images during initialization"""
        print("Extracting patches from all images...")
        
        for idx, (image_path, label) in enumerate(tqdm(zip(self.image_paths, self.labels))):
            image = io.imread(image_path)
            
            # Apply stain normalization if requested
            if self.apply_normalization:
                image = macenko_stain_normalization(image)
            
            # Extract patches
            patches, coordinates = tile_image(
                image, 
                patch_size=self.patch_size,
                min_foreground_ratio=self.min_foreground_ratio
            )
            
            # Store patches with metadata
            for patch, coord in zip(patches, coordinates):
                self.patches.append(patch)
                self.patch_labels.append(label)
                self.patch_metadata.append({
                    'image_id': idx,
                    'image_path': image_path,
                    'coordinates': coord
                })
        
        print(f"Extracted {len(self.patches)} patches from {len(self.image_paths)} images")
    
    def __len__(self):
        return len(self.patches)
    
    def __getitem__(self, idx):
        patch = self.patches[idx]
        label = self.patch_labels[idx]
        metadata = self.patch_metadata[idx]
        
        # Apply transforms if provided
        if self.transform:
            patch = self.transform(patch)
        
        return patch, label, metadata


def save_patches_to_directory(dataset, output_dir):
    """
    Save extracted patches to a structured directory
    
    Args:
        dataset (OSCCDataset): Dataset containing patches
        output_dir (str): Output directory path
    """
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    # Create subdirectories for each class
    normal_dir = output_dir / "Normal"
    oscc_dir = output_dir / "OSCC"
    normal_dir.mkdir(exist_ok=True)
    oscc_dir.mkdir(exist_ok=True)
    
    print(f"Saving patches to {output_dir}")
    
    for idx in tqdm(range(len(dataset))):
        patch, label, metadata = dataset[idx]
        
        # Determine subdirectory
        subdir = normal_dir if label == 0 else oscc_dir
        class_name = "Normal" if label == 0 else "OSCC"
        
        # Create filename with metadata
        image_id = metadata['image_id']
        row, col = metadata['coordinates']
        filename = f"{class_name}_img{image_id:04d}_r{row}_c{col}.png"
        
        # Save patch
        filepath = subdir / filename
        io.imsave(filepath, patch)


def create_data_splits(image_paths, labels, test_size=0.2, val_size=0.2, random_state=42):
    """
    Create train/validation/test splits with stratification
    
    Args:
        image_paths (list): List of image paths
        labels (list): List of labels
        test_size (float): Proportion of test set
        val_size (float): Proportion of validation set (from remaining data)
        random_state (int): Random state for reproducibility
    
    Returns:
        tuple: (train_paths, val_paths, test_paths, train_labels, val_labels, test_labels)
    """
    # First split: separate test set
    train_val_paths, test_paths, train_val_labels, test_labels = train_test_split(
        image_paths, labels, test_size=test_size, random_state=random_state, 
        stratify=labels
    )
    
    # Second split: separate train and validation
    train_paths, val_paths, train_labels, val_labels = train_test_split(
        train_val_paths, train_val_labels, test_size=val_size, 
        random_state=random_state, stratify=train_val_labels
    )
    
    print(f"Data splits created:")
    print(f"  Training: {len(train_paths)} images")
    print(f"  Validation: {len(val_paths)} images") 
    print(f"  Test: {len(test_paths)} images")
    
    return train_paths, val_paths, test_paths, train_labels, val_labels, test_labels


